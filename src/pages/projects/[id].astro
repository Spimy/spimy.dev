---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import PageMain from '../../components/PageMain.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects
		.filter((project) => project.body?.trim())
		.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, date, context, summary, tags, links, role, status } =
	project.data;

// The strip under the title. Role and status only show when the .md sets them
const meta = [
	{ key: 'Stack', value: tags.join(' · ') },
	{ key: 'Year', value: date.slice(0, 4) },
	role ? { key: 'Role', value: role } : null,
	status ? { key: 'Status', value: status } : null,
].filter((item) => item !== null);

// Links that open something you can use or watch get a play arrow
const PLAYABLE = ['Live', 'Demo', 'Video'];
---

<Layout title={title} description={summary}>
	<PageMain>
		<article class="dossier">
			<span class="dossier__stamp" aria-hidden="true">Owned</span>

			<header class="dossier__header">
				<a class="dossier__back" href="/projects">← Back to inventory</a>
				<h1 class="dossier__title">{title}</h1>
				{context && <p class="dossier__context">{context}</p>}

				<dl class="dossier__meta">
					{
						meta.map(({ key, value }) => (
							<div class="dossier__meta-item">
								<dt class="dossier__meta-key">{key}</dt>
								<dd class="dossier__meta-value">{value}</dd>
							</div>
						))
					}
				</dl>

				{
					links.length > 0 && (
						<ul class="dossier__links" role="list">
							{links.map(({ label, url }, index) => (
								<li>
									<a
										class:list={[
											'dossier__link',
											{
												'dossier__link--primary': index === 0,
												'dossier__link--play':
													index === 0 && PLAYABLE.includes(label),
											},
										]}
										href={url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{label}
										<span class="sr-only"> (opens in a new tab)</span>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</header>

			<div class="dossier__body">
				<Content />
			</div>

			<span class="dossier__status" aria-hidden="true">Debrief complete</span>
		</article>
	</PageMain>
</Layout>

<style>
	.dossier {
		position: relative;
		width: 100%;
		max-width: 51.25rem;
		margin: 0 auto;
	}

	.dossier__stamp {
		position: absolute;
		top: 0.75rem;
		right: 1.25rem;
		z-index: 1;
		transform: rotate(8deg);
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.8125rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-pop);
		border: 3px solid var(--accent-pop);
		padding: 0.375rem 0.875rem;
		opacity: 0.85;
	}

	@media (max-width: 640px) {
		.dossier__stamp {
			position: static;
			display: inline-block;
			margin-bottom: 0.75rem;
			transform: none;
		}
	}

	.dossier__header {
		margin-bottom: 1.75rem;
		padding: 1.625rem 1.75rem;
		background: var(--panel);
		border: 3px solid var(--ink);
		box-shadow: 0.5rem 0.5rem 0 var(--accent-pop);
	}

	.dossier__back {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-decoration: none;
		color: var(--accent-soft);
	}

	.dossier__title {
		margin: 0.875rem 0 0.625rem;
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: clamp(1.8rem, 4.5vw, 2.5rem);
		line-height: 0.95;
		color: var(--text);
	}

	.dossier__context {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.71875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.dossier__meta {
		display: flex;
		flex-wrap: wrap;
		margin: 1rem 0 0;
		border-top: 1px solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.71875rem;
	}

	.dossier__meta-item {
		margin-right: 1.125rem;
		padding: 0.625rem 1.125rem 0 0;
		border-right: 1px solid var(--ink);
	}

	.dossier__meta-item:last-child {
		margin-right: 0;
		border-right: 0;
	}

	.dossier__meta-key {
		display: block;
		margin-bottom: 0.25rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.dossier__meta-value {
		margin: 0;
		color: var(--text-muted);
	}

	.dossier__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin: 1.125rem 0 0;
		padding: 0;
		list-style: none;
	}

	.dossier__link {
		display: inline-block;
		padding: 0.625rem 1rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.75rem;
		text-decoration: none;
		text-transform: uppercase;
		color: var(--text);
		background: var(--panel-2);
		border: 2px solid var(--ink);
	}

	.dossier__link:hover {
		border-color: var(--accent-soft);
	}

	.dossier__link--primary {
		color: var(--on-accent);
		background: var(--accent);
	}

	.dossier__link--play::before {
		content: '▶ ';
	}

	/* The write-up/notes is Markdown rendered by Astro, so its elements don't get this
	   component's scope attribute. :global() lets the styles reach them. */
	.dossier__body :global(h2) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.625rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-pop);
	}

	.dossier__body :global(h2::before) {
		content: '';
		width: 1rem;
		height: 2px;
		background: var(--accent-pop);
	}

	.dossier__body :global(p),
	.dossier__body :global(ul),
	.dossier__body :global(ol) {
		margin: 0 0 1.625rem;
		max-width: 70ch;
		font-family: var(--font-mono);
		font-size: 0.92rem;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.dossier__body :global(ul),
	.dossier__body :global(ol) {
		padding-left: 1.25rem;
	}

	.dossier__body :global(li) {
		margin-bottom: 0.375rem;
	}

	.dossier__body :global(strong) {
		color: var(--text);
	}

	.dossier__body :global(code) {
		font-size: 0.9em;
		color: var(--text);
		background: var(--panel-2);
		padding: 0.125rem 0.375rem;
	}

	.dossier__body :global(img) {
		max-width: 100%;
		height: auto;
		border: 2px solid var(--ink);
	}

	/* Intentionally redacted content for fun/stylistic purposes */
	.dossier__body :global(.redacted) {
		display: inline-block;
		padding: 0 0.25rem;
		color: var(--text-muted);
		background: var(--text-muted);
		border-radius: 2px;
		user-select: none;
	}

	.dossier__status {
		display: inline-block;
		margin-top: 0.375rem;
		padding: 0.375rem 0.75rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.6875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-soft);
		border: 2px solid var(--accent-soft);
	}
</style>
