---
export const prerender = true;

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import spimyLogo from '../assets/logo.png';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { dateRange, gearForJob, getJobs, numeral } from '../lib/experience';

const jobs = await getJobs();
const phases = await Promise.all(
	jobs.map(async (job) => {
		const gear = gearForJob(job);
		return {
			...job.data,
			id: job.id,
			phase: job.phase,
			status: job.status,
			range: dateRange(job),
			gears:
				gear.length > 0
					? gear.map(({ id, name }) => ({ id, name }))
					: job.status === 'upcoming'
						? [null, null, null]
						: [],
			hasLog: !!job.body?.trim(),
			Content: (await render(job)).Content,
		};
	}),
);

const defaultPhaseId =
	phases.find((p) => p.status !== 'upcoming')?.id ?? phases[0]?.id;

const level = new Date().getFullYear() - 2003;
const cleared = phases.filter((p) => p.status !== 'upcoming').length;
const totalPhases = phases.length + 1;
const nextNumeral = numeral(phases.length);

const logoFiles = import.meta.glob<ImageMetadata>(
	'../assets/logos/*.{svg,png,webp}',
	{ eager: true, import: 'default' },
);

const companyLogoFiles = import.meta.glob<ImageMetadata>(
	'../assets/companies/*.{svg,png,webp}',
	{ eager: true, import: 'default' },
);

function companyLogoFor(name?: string): ImageMetadata | undefined {
	if (!name) return undefined;
	if (name === 'spimy') return spimyLogo;
	for (const ext of ['svg', 'png', 'webp']) {
		const logo = companyLogoFiles[`../assets/companies/${name}.${ext}`];
		if (logo) return logo;
	}
}

const hostOf = (url: string) => {
	const u = new URL(url);
	return u.hostname.includes('linkedin.com')
		? 'LinkedIn'
		: u.hostname.replace(/^www\./, '');
};

function logoFor(id: string): ImageMetadata | undefined {
	for (const ext of ['svg', 'png', 'webp']) {
		const logo = logoFiles[`../assets/logos/${id}.${ext}`];
		if (logo) return logo;
	}
}

const anchorIds = [...phases.map((p) => p.id), 'open'];

const selected = (when: string, id: string) => `
${when} .sheet--${id} { display: block; }
${when} .track__phase--${id} {
	background: var(--accent);
	color: var(--on-accent);
	border-color: var(--ink);
	box-shadow: 0.375rem 0.375rem 0 var(--accent-pop);
}
${when} .track__phase--${id} .track__meta,
${when} .track__phase--${id} .track__role { color: var(--on-accent); }`;

const phaseCss = [
	...anchorIds.map((id) => selected(`body:has(#${id}:target)`, id)),
	defaultPhaseId
		? selected('body:not(:has(.phase-anchor:target))', defaultPhaseId)
		: '',
].join('\n');

const statusLabel = {
	upcoming: 'Starting',
	current: 'Ongoing',
	done: 'Cleared',
} as const;
---

<Layout
	title="Experience"
	description="Spimy's work experience, shown as ascension phases: where I've worked, what I did and what each job unlocked."
>
	<Fragment slot="state">
		<style is:inline set:html={phaseCss}></style>
	</Fragment>

	<section class="levelup" id="main-content">
		<div class="levelup__bg" aria-hidden="true">
			<span class="levelup__stripe levelup__stripe--primary"></span>
			<span class="levelup__stripe levelup__stripe--secondary"></span>
			<span class="levelup__bg-text">Ascend</span>
		</div>

		<div class="levelup__inner">
			<header class="levelup__header">
				<a class="levelup__back" href="/">
					<Icon name="chevron-left" class="levelup__back-icon" />
					Back to status
				</a>
				<h1 class="levelup__title">Experience</h1>
				<p class="levelup__subtitle">
					Character page II - <strong>work experience</strong>, or EXP. Every
					job is an ascension phase, newest first. Pick one to see what I did
					there and what it unlocked.
				</p>
			</header>

			<div class="levelup__layout">
				<nav class="track" aria-label="Jobs">
					<div class="track__meter">
						<span class="track__level">
							LV. <strong>{level}</strong>
						</span>
						<span
							class="track__stars"
							aria-label={`${cleared} of ${totalPhases} phases reached`}
						>
							{Array.from({ length: totalPhases }, (_, i) => (
								<Icon
									name="star"
									filled={i < cleared}
									class:list={[
										'track__star',
										{ 'track__star--on': i < cleared },
									]}
								/>
							))}
						</span>
					</div>

					<ol class="track__list" role="list">
						<li>
							<a class="track__phase track__phase--open" href="#open">
								<span
									class="track__numeral track__numeral--open"
									aria-hidden="true"
								>
									{nextNumeral}
								</span>
								<span class="track__body">
									<span class="track__company">Your team?</span>
									<span class="track__role">Open slot</span>
									<span class="track__meta">Requires 1 × Job offer</span>
								</span>
								<span class="track__pill track__pill--open">Locked</span>
							</a>
						</li>
						{phases.map((p) => (
							<li>
								<a
									class:list={[
										'track__phase',
										`track__phase--${p.id}`,
										{ 'track__phase--upcoming': p.status === 'upcoming' },
									]}
									href={`#${p.id}`}
								>
									<span class="track__numeral" aria-hidden="true">
										{p.phase}
									</span>
									<span class="track__body">
										<span class="track__company">{p.company}</span>
										<span class="track__role">{p.role}</span>
										<span class="track__meta">{p.range}</span>
									</span>
									<span
										class:list={['track__pill', `track__pill--${p.status}`]}
									>
										{statusLabel[p.status]}
									</span>
								</a>
							</li>
						))}
					</ol>
				</nav>

				<div class="sheets">
					{anchorIds.map((id) => (
						<span class="phase-anchor" id={id} aria-hidden="true" />
					))}

					{phases.map((p) => (
						<article
							class:list={[
								'sheet',
								`sheet--${p.id}`,
								{ 'sheet--upcoming': p.status === 'upcoming' },
							]}
							aria-labelledby={`sheet-title-${p.id}`}
						>
							<header class="sheet__header">
								<div class="sheet__kicker">
									// Ascension phase {p.phase}
									<span class="sheet__type">{p.type}</span>
								</div>
								<div class="sheet__identity">
									{(() => {
										const logo = companyLogoFor(p.logo);
										return (
											<span class="sheet__logo" aria-hidden="true">
												{logo ? (
													<Image
														src={logo}
														alt=""
														width={128}
														class="sheet__logo-img"
													/>
												) : (
													<span class="sheet__logo-initial">
														{p.company[0]}
													</span>
												)}
											</span>
										);
									})()}
									<div class="sheet__identity-text">
										<h2 class="sheet__title" id={`sheet-title-${p.id}`}>
											{p.company}
										</h2>
										<p class="sheet__role">{p.role}</p>
										<p class="sheet__meta">
											{p.location} · {p.range}
										</p>
									</div>
								</div>
								{p.url && (
									<a
										class="sheet__link"
										href={p.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{hostOf(p.url)}
										<Icon name="arrow-up-right" class="sheet__link-icon" />
										<span class="sr-only"> (opens in a new tab)</span>
									</a>
								)}
							</header>

							<p class="sheet__summary">{p.summary}</p>

							<h3 class="sheet__label">Ascension bonus</h3>
							<dl class="bonus">
								{p.bonuses.map((b) => (
									<div class="bonus__row">
										<dt class="bonus__label">{b.label}</dt>
										<dd class="bonus__values">
											<span class="bonus__before">{b.before}</span>
											<span class="bonus__arrow">
												<Icon name="arrow-right" />
												<span class="sr-only">to</span>
											</span>
											<span class="bonus__after">{b.after}</span>
										</dd>
									</div>
								))}
							</dl>

							<h3 class="sheet__label">Loadout</h3>
							<ul class="items" role="list">
								{p.gears.map((m) => {
									const logo = m ? logoFor(m.id) : undefined;
									const name = m ? m.name : 'Locked';
									return (
										<li class:list={['item', { 'item--locked': !m }]}>
											<span class="item__icon" aria-hidden="true">
												{logo ? (
													<Image
														src={logo}
														alt=""
														width={56}
														class="item__logo"
													/>
												) : (
													'?'
												)}
											</span>
											<span class="item__name">{name}</span>
										</li>
									);
								})}
							</ul>

							<h3 class="sheet__label">Battle log</h3>
							{p.hasLog ? (
								<div class="log">
									<p.Content />
								</div>
							) : (
								<p class="log__locked">
									<Icon name="lock" class="log__lock-icon" />
									Unlocks after the first few quests at this phase.
								</p>
							)}
						</article>
					))}

					<article class="sheet sheet--open" aria-labelledby="sheet-title-open">
						<header class="sheet__header">
							<div class="sheet__kicker">
								// Ascension phase {nextNumeral}
								<span class="sheet__type">Open slot</span>
							</div>
							<h2 class="sheet__title" id="sheet-title-open">
								Your team?
							</h2>
							<p class="sheet__role">Full stack or backend developer</p>
							<p class="sheet__meta">
								Remote, hybrid or on-site · Happy to relocate
							</p>
						</header>

						<p class="sheet__summary">
							The next phase isn't written yet. If you're hiring, or have a
							project in mind, this is the slot.
						</p>

						<h3 class="sheet__label">Ascension bonus</h3>
						<dl class="bonus">
							<div class="bonus__row">
								<dt class="bonus__label">Party size</dt>
								<dd class="bonus__values">
									<span class="bonus__before">Yours</span>
									<span class="bonus__arrow">
										<Icon name="arrow-right" />
										<span class="sr-only">to</span>
									</span>
									<span class="bonus__after">Yours + 1</span>
								</dd>
							</div>
						</dl>

						<h3 class="sheet__label">Ascension materials</h3>
						<ul class="items" role="list">
							<li class="item item--required">
								<span class="item__icon" aria-hidden="true">
									<Icon name="mail" class="item__mail" />
								</span>
								<span class="item__name">Job offer</span>
								<span class="item__count">0 / 1</span>
							</li>
						</ul>

						<a
							class="ascend ascend--big"
							href="/contact"
							aria-label="Ascend: contact me about hiring"
						>
							<span class="ascend__cost">
								<span class="ascend__cost-label">Cost</span> 1 × Job offer
							</span>
							<span class="ascend__button">
								Ascend
								<Icon name="chevrons-right" class="ascend__icon" />
							</span>
						</a>
					</article>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.levelup {
		position: relative;
		z-index: 1;
		overflow: hidden;
		min-height: 100svh;
		background: var(--ink);
		border-bottom: 3px solid var(--accent);
		padding: 3.25rem 1.5rem 3rem;
	}

	.levelup__bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.levelup__stripe {
		position: absolute;
		top: -10%;
		height: 130%;
		transform: skewX(-14deg);
	}

	.levelup__stripe--primary {
		right: 8%;
		width: 16%;
		background: var(--accent);
		opacity: 0.35;
	}

	.levelup__stripe--secondary {
		right: 2%;
		width: 4%;
		background: var(--accent-pop);
		opacity: 0.45;
	}

	.levelup__bg-text {
		position: absolute;
		right: -4%;
		bottom: 2%;
		white-space: nowrap;
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: min(18vw, 13rem);
		letter-spacing: 0.375rem;
		color: transparent;
		-webkit-text-stroke: 2px
			color-mix(in srgb, var(--accent-soft) 14%, transparent);
		transform: rotate(-6deg);
		user-select: none;
	}

	.levelup__inner {
		position: relative;
		z-index: 2;
		max-width: 67.5rem;
		margin: 0 auto;
	}

	.levelup__back {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		text-decoration: none;
		margin-bottom: 1rem;
	}

	.levelup__back :global(.levelup__back-icon) {
		width: 0.875rem;
		height: 0.875rem;
	}

	.levelup__back:hover {
		color: var(--text);
	}

	.levelup__title {
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: clamp(2.2rem, 6vw, 3.4rem);
		line-height: 0.92;
		margin: 0 0 0.875rem;
		color: var(--text);
		text-shadow: 0.25rem 0.25rem 0 var(--accent-pop);
	}

	.levelup__subtitle {
		color: var(--text-muted);
		font-size: 1.02rem;
		line-height: 1.6;
		max-width: 62ch;
		margin: 0 0 2.25rem;
	}

	.levelup__subtitle strong {
		color: var(--text);
	}

	.levelup__layout {
		display: grid;
		grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
		gap: 1.75rem;
		align-items: start;
	}

	@media (max-width: 900px) {
		.levelup__layout {
			grid-template-columns: 1fr;
		}
	}

	.phase-anchor {
		position: fixed;
		top: 0;
		left: 0;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	@media (max-width: 900px) {
		.phase-anchor {
			position: static;
			display: block;
			scroll-margin-top: 1rem;
		}
	}

	.track__meter {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.625rem 0.875rem;
		margin-bottom: 0.875rem;
		background: var(--panel-2);
		border: 2px solid var(--ink);
		box-shadow: 0.25rem 0.25rem 0 var(--accent-soft);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8125rem;
	}

	.track__level strong {
		color: var(--accent-soft);
		font-size: 1rem;
	}

	.track__stars {
		display: flex;
		gap: 0.25rem;
	}

	.track__stars :global(.track__star) {
		width: 0.875rem;
		height: 0.875rem;
		color: color-mix(in srgb, var(--text-muted) 35%, transparent);
	}

	.track__stars :global(.track__star--on) {
		color: var(--accent-pop);
	}

	.track__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.track__phase {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		align-items: center;
		gap: 0.875rem;
		padding: 0.75rem 0.875rem;
		cursor: pointer;
		color: var(--text);
		text-decoration: none;
		background: var(--panel);
		border: 2px solid var(--ink);
		clip-path: polygon(0 0.75rem, 0.75rem 0, 100% 0, 100% 100%, 0 100%);
		transition:
			transform 0.12s ease,
			background 0.12s ease;
	}

	.track__phase:hover {
		transform: translateX(0.25rem);
		border-color: var(--accent-soft);
	}

	.track__phase:focus-visible {
		outline: 2px solid var(--accent-pop);
		outline-offset: -0.375rem;
	}

	.track__phase--upcoming {
		border-style: dashed;
		border-color: color-mix(in srgb, var(--accent-soft) 55%, transparent);
	}

	.track__numeral {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.125rem;
		color: var(--on-pop);
		background: var(--accent-pop);
		clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
	}

	.track__body {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}

	.track__company {
		font-family: var(--font-mono);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.875rem;
	}

	.track__role {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	.track__meta {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--accent-soft);
	}

	.track__pill {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.5625rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.25rem 0.4375rem;
		border: 1px solid currentColor;
		white-space: nowrap;
	}

	.track__pill--done {
		color: var(--text-muted);
	}

	.track__pill--current {
		color: var(--ok);
	}

	.track__pill--upcoming {
		color: var(--accent-pop);
		background: var(--ink);
	}

	.sheet {
		display: none;
		position: relative;
		background: color-mix(in srgb, var(--panel) 90%, transparent);
		backdrop-filter: blur(6px);
		border: 2px solid var(--ink);
		box-shadow: 0.5rem 0.5rem 0 var(--accent);
		padding: 1.75rem 2rem 2rem;
		clip-path: polygon(
			0 1.125rem,
			1.125rem 0,
			100% 0,
			100% calc(100% - 2rem),
			calc(100% - 2rem) 100%,
			0 100%
		);
	}

	.sheet--upcoming {
		box-shadow: 0.5rem 0.5rem 0 var(--accent-pop);
	}

	.sheet__kicker {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-soft);
		margin-bottom: 0.5rem;
	}

	.sheet__type {
		color: var(--text-muted);
		border: 1px solid currentColor;
		padding: 0.125rem 0.4375rem;
		letter-spacing: 0.06em;
	}

	.sheet__title {
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: clamp(1.9rem, 5vw, 2.75rem);
		line-height: 0.95;
		margin: 0 0 0.5rem;
		color: var(--text);
		text-shadow: 0.1875rem 0.1875rem 0 var(--accent-pop);
	}

	.sheet__role {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.875rem;
		color: var(--accent-soft);
	}

	.sheet__meta {
		margin: 0.25rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.sheet__summary {
		color: var(--text-muted);
		line-height: 1.65;
		margin: 1.125rem 0 0;
		max-width: 60ch;
	}

	.sheet__label {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-pop);
		margin: 1.625rem 0 0.625rem;
		padding-bottom: 0.375rem;
		border-bottom: 1px solid var(--ink);
	}

	.bonus {
		margin: 0;
		display: grid;
		gap: 0;
	}

	.bonus__row {
		display: grid;
		grid-template-columns: 9rem 1fr;
		align-items: baseline;
		gap: 1rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.bonus__label {
		color: var(--text-muted);
	}

	.bonus__values {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}

	.bonus__before {
		color: var(--text-muted);
	}

	.bonus__arrow {
		display: inline-flex;
		align-self: center;
		color: var(--accent-pop);
	}

	.bonus__arrow :global(.bonus__arrow-icon) {
		width: 0.875rem;
		height: 0.875rem;
	}

	.bonus__after {
		color: var(--ok);
