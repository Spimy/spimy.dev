---
import PageHeader from '../components/PageHeader.astro';
import PageMain from '../components/PageMain.astro';
import Panel from '../components/Panel.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="This page does not exist." noindex>
	<PageHeader
		title="404: Area not found"
		subtitle="You wandered off the map. Nothing is on this page."
	/>

	<PageMain>
		<Panel kicker="// ERROR 404 — PAGE NOT FOUND" title="Game over?" tone="pop">
			<Fragment slot="intro">
				The address you opened does not lead anywhere on this site. It may be
				mistyped, or the page may have moved or been removed.
			</Fragment>

			<ul class="lost__links" role="list">
				<li><a class="lost__link" href="/">Home</a></li>
				<li><a class="lost__link" href="/projects">Inventory</a></li>
				<li><a class="lost__link" href="/contact">Party Chat</a></li>
			</ul>

			<div class="dialogue" role="note">
				<span class="dialogue__name">???</span>
				<p class="dialogue__text">
					How about we explore the area ahead of us later?
				</p>
				<span class="dialogue__next" aria-hidden="true">▼</span>
			</div>
		</Panel>
	</PageMain>
</Layout>

<style>
	.lost__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.lost__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.5rem 1.25rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--accent-soft);
		background: var(--panel);
		border: 2px solid var(--ink);
	}

	.lost__link:hover,
	.lost__link:focus-visible {
		background: var(--accent-soft);
		color: var(--on-accent);
	}

	/* Visual novel text box, same look as the one on the home page. */
	.dialogue {
		position: relative;
		width: 100%;
		max-width: 30rem;
		margin-top: 2.5rem;
		padding: 1.5rem 1.5rem 1.25rem;
		background: color-mix(in srgb, var(--panel) 92%, transparent);
		border: 2px solid var(--ink);
		box-shadow: 0.375rem 0.375rem 0 var(--accent-pop);
	}

	.dialogue__name {
		position: absolute;
		top: -0.9375rem;
		left: 1rem;
		padding: 0.25rem 1.25rem 0.25rem 1rem;
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: 1rem;
		line-height: 1.2;
		color: var(--on-pop);
		background: var(--accent-pop);
		clip-path: polygon(0 0, 100% 0, calc(100% - 0.5rem) 100%, 0 100%);
	}

	.dialogue__text {
		margin: 0;
		padding-right: 1rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--text);
	}

	.dialogue__next {
		position: absolute;
		right: 0.875rem;
		bottom: 0.5rem;
		font-size: 0.625rem;
		color: var(--accent-soft);
	}
</style>
