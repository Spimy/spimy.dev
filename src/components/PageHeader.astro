---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="page-header">
	<h1 class="page-header__title">{title}</h1>
	{subtitle && <p class="page-header__subtitle">{subtitle}</p>}
</header>

<style>
	.page-header {
		position: relative;
		z-index: 1;
		max-width: 67.5rem;
		margin: 0 auto;
		padding: 3.25rem 1.5rem 0.5rem;
	}

	.page-header__title {
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: clamp(2.2rem, 6vw, 3.4rem);
		line-height: 0.92;
		margin: 0 0 0.875rem;
		color: var(--text);
		text-shadow: 0.25rem 0.25rem 0 var(--accent-pop);
	}

	.page-header__subtitle {
		color: var(--text-muted);
		font-size: 1.02rem;
		max-width: 75ch;
		line-height: 1.6;
		margin: 0;
		text-wrap: pretty;
	}
</style>
