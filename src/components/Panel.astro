---
interface Props {
	kicker: string;
	title: string;
	tone?: 'accent' | 'soft' | 'pop';
}

const { kicker, title, tone = 'accent' } = Astro.props;
const hasIntro = Astro.slots.has('intro');
---

<section
	class:list={[
		'panel',
		{ 'panel--soft': tone === 'soft', 'panel--pop': tone === 'pop' },
	]}
>
	<div class="panel__kicker">{kicker}</div>
	<span class="panel__title-wrap"><h2 class="panel__title">{title}</h2></span>
	{
		hasIntro && (
			<p class="panel__intro">
				<slot name="intro" />
			</p>
		)
	}
	<slot />
</section>

<style>
	.panel {
		position: relative;
		background: var(--panel);
		border: 3px solid var(--ink);
		box-shadow: 0.5rem 0.5rem 0 var(--accent);
		padding: 1.875rem 2rem 2rem;
		clip-path: polygon(
			0 1.375rem,
			1.375rem 0,
			100% 0,
			100% calc(100% - 2.5rem),
			calc(100% - 2.5rem) 100%,
			0 100%
		);
		scroll-margin-top: 1.5rem;
	}

	.panel--soft {
		box-shadow: 0.5rem 0.5rem 0 var(--accent-soft);
	}

	.panel--pop {
		box-shadow: 0.5rem 0.5rem 0 var(--accent-pop);
	}

	.panel__kicker {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--accent-soft);
		letter-spacing: 0.1em;
		margin-bottom: 0.5rem;
	}

	.panel__title-wrap {
		position: relative;
		margin-bottom: 0.375rem;
		display: inline-block;
	}

	.panel__title-wrap::before {
		content: '';
		position: absolute;
		left: -0.875rem;
		top: 48%;
		width: 70%;
		height: 1rem;
		background: var(--accent-pop);
		transform: skewX(-12deg);
		z-index: -1;
		opacity: 0.85;
	}

	.panel__title {
		font-family: var(--font-display);
		font-style: italic;
		text-transform: uppercase;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		line-height: 0.95;
		margin: 0;
		color: var(--text);
	}

	.panel__intro {
		color: var(--text-muted);
		line-height: 1.7;
		max-width: 64ch;
		margin-top: 0.875rem;
	}
</style>
