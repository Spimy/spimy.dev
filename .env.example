GITHUB_TOKEN=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Defaults to SMTP_USER when left out
CONTACT_TO=
CONTACT_FROM=

HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Optional. Used to sign form tokens. Without it, a new key is made on each start.
# Recommended: a random 32-byte hex string, e.g. `openssl rand -hex 32`
CONTACT_SECRET=